#!/usr/bin/env python3
"""Icinga Modern Notifications launcher.

This script is meant to be installed next to the ``icinga_modern_notifications``
package and the notification templates, for example in
``/usr/local/libexec/icinga-modern-notifications/``. The directory containing
this script (after resolving symlinks) is used as the default template
directory.
"""

import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent

if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))

from icinga_modern_notifications.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(default_template_dir=SCRIPT_DIR))
